const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('tkreel-cli v1.0.0 (https://tkreel.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'tkreel.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
